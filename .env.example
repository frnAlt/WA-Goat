# ==========================================
# GOAT BOT V2 (WHATSAPP EDITION) ENVIRONMENT
# ==========================================

# Bot Identity
BOT_NAME="Goat Bot V2"
BOT_VERSION="2.0.0"
PREFIX="!"
LANGUAGE="en"

# Bot Owner & Administrators
# Phone number with international code without '+' or spaces (e.g., 1234567890 or 8801700000000)
OWNER_NAME="Farhan"
OWNER_NUMBER="1234567890"
SUDO_NUMBERS="1234567890"

# WhatsApp Connection (Baileys v7.0.0-rc14)
# SESSION_PATH is the folder where authentication credentials will be preserved
SESSION_PATH="./auth"
PAIRING_CODE=false
PAIRING_NUMBER=""

# Bot Runtime & Logging
NODE_ENV="production"
LOG_LEVEL="info"
TIMEZONE="Asia/Dhaka"
PORT=3000

# Database Configuration (json | sqlite)
DATABASE_TYPE="json"
DATABASE_URL="./data/database.sqlite"

# Automation & Protection Defaults
AUTO_READ=false
AUTO_TYPING=false
AUTO_STATUS=false
ANTI_CALL=false
ANTI_LINK=false
ANTI_BADWORD=false

# External API Integrations (Optional)
WEATHER_API_KEY="d7e795ae6a0d44aaa8abb1a0a7ac19e4"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
